{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "format": "npx prettier --write .",
    "start": "concurrently \"php artisan serve --host=0.0.0.0\" \"npm run dev\" \"php artisan queue:work\" \"php artisan reverb:start\" ",
    "clear-all": "concurrently \"php artisan optimize:clear\" \"php artisan view:clear\" \"php artisan cache:clear\"",
    "dbreset": "php artisan migrate:fresh --seed"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-react": "^4.3.1",
    "axios": "^1.11.0",
    "concurrently": "^9.0.1",
    "laravel-echo": "^2.3.4",
    "laravel-vite-plugin": "^2.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-blade": "^3.1.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "pusher-js": "^8.5.0",
    "tailwindcss": "^4.2.1",
    "vite": "^7.0.7",
    "ziggy-js": "^2.6.2"
  },
  "dependencies": {
    "@inertiajs/react": "^3.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
